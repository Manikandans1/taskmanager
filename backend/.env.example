# Copy this file to .env (or set these as real environment variables) and fill in your values.
# This file is never read directly by Spring Boot - export these into your shell,
# or configure them as environment variables on your host (Render/Railway/etc).

PORT=8080

DATABASE_URL=jdbc:postgresql://<your-host>:5432/<your-db-name>
DATABASE_USERNAME=<your-db-username>
DATABASE_PASSWORD=<your-db-password>

JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRATION_MS=86400000

GROQ_API_KEY=<your-groq-api-key>
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.1-8b-instant

CORS_ALLOWED_ORIGINS=http://localhost:5173
