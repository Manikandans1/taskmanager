# Base URL of your deployed (or local) backend API.
# Local dev default (matches backend application.properties server.port):
VITE_API_URL=http://localhost:8080/api

# When deploying the frontend (e.g. to Vercel), set this to your deployed
# backend URL, e.g.:
# VITE_API_URL=https://your-backend.onrender.com/api
